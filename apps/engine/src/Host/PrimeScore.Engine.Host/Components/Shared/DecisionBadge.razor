@using PrimeScore.Modules.Decision.Contracts

<span class="status @(Outcome == DecisionOutcome.Deploy && !DecisionCopy.IsLegacy(Scenario) ? "" : "status-muted")"
      title="@DecisionCopy.OutcomeTooltip(Outcome, Scenario)">
    @DecisionCopy.Outcome(Outcome, Scenario)
</span>

@code {
    [Parameter, EditorRequired]
    public DecisionOutcome Outcome { get; set; }

    /// <summary>The decision's stored state (the <c>scenario</c> field); legacy labels render as legacy outcomes.</summary>
    [Parameter, EditorRequired]
    public string Scenario { get; set; } = "";
}
