@using PrimeScore.Modules.Decision.Contracts

<span class="status @(Outcome == DecisionOutcome.Deploy ? "" : "status-muted")"
      title="@(Outcome == DecisionOutcome.Deploy ? "All recorded checks passed. This is a research result; no position or order was created." : "One or more checks did not pass. No position or order was created.")">
    @DecisionCopy.Outcome(Outcome)
</span>

@code {
    [Parameter, EditorRequired]
    public DecisionOutcome Outcome { get; set; }
}
