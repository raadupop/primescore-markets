@using PrimeScore.Modules.Classification.Contracts

@* One signal's classification outcome in a table cell: severity and certainty, or why there is none. *@
@if (Outcome is null)
{
    <span class="status status-muted" title="The next analysis run will assess this observation.">Awaiting analysis</span>
}
else if (!Outcome.Available)
{
    <span class="status @(Outcome.Reason is UnavailableReason.ClassifierUnreachable or UnavailableReason.InvalidResponse ? "status-bad" : "status-muted")"
          title="@Outcome.Detail">@Reason(Outcome.Reason)</span>
}
else
{
    <div class="assessment-summary">
        <span title="Signed severity from −1 to +1. The sign gives the direction of the deviation; the magnitude ranks it against earlier history.">Severity <strong>@Fmt.Signed(Outcome.Score, 2)</strong></span>
        <span class="panel-note" title="Confidence reflects the amount and freshness of the comparison history. It is not a probability of profit.">Confidence <strong>@Fmt.Percent(Outcome.Certainty)</strong></span>
    </div>
    @if (Outcome.IsFallback)
    {
        <span class="status status-warn" title="The analysis service gave no valid answer, so the last valid assessment was reused.">Previous assessment · @Stale(Outcome.StalenessSeconds)</span>
    }
    @foreach (var flag in Outcome.Flags)
    {
        <span class="status status-warn" title="@FlagTitle(flag)">@FlagLabel(flag)</span>
    }
}

@code {
    [Parameter]
    public AssessmentView? Outcome { get; set; }

    public static string Reason(UnavailableReason? reason) => reason switch
    {
        UnavailableReason.AwaitingConsensus => "Missing consensus estimate",
        UnavailableReason.RouteNotImplemented => "Input type not yet supported",
        UnavailableReason.ClassifierUnreachable => "Analysis service unavailable",
        UnavailableReason.InvalidResponse => "Invalid analysis result",
        UnavailableReason.ClassifierRejected => "Observation rejected by analysis",
        UnavailableReason.UnknownIndicator => "Indicator not recognised",
        UnavailableReason.OutsideClassifiedHistory => "Before classified history",
        UnavailableReason.DuplicateObservation => "Same-day observation already analysed",
        _ => "Not analysed",
    };

    public static string FlagLabel(string flag) => flag switch
    {
        "insufficient_history" => "Too little history",
        "window_degenerate" => "History has little variation",
        "unknown_indicator" => "Unknown indicator",
        "fit_rejected" => "Statistical fit rejected",
        _ => Fmt.Humanize(flag),
    };

    public static string FlagTitle(string flag) => flag switch
    {
        "insufficient_history" => "Too few earlier observations to rank this value; severity and confidence are zero.",
        "window_degenerate" => "The recent comparison history has a single distinct value; confidence is reduced.",
        "unknown_indicator" => "The indicator is not registered; severity is zero.",
        "fit_rejected" => "The fitted distribution did not meet the statistical checks; confidence is reduced.",
        _ => "Analysis quality marker",
    };

    public static string Stale(double? seconds) => seconds is null ? "age unknown" : $"{Fmt.Duration(seconds)} old";
}
