@using PrimeScore.Engine.Host.Health
@inject EngineHealthService HealthService

<section class="panel" aria-labelledby="health-title">
    <div class="panel-head">
        <div>
            <div class="kicker">Operations</div>
            <h2 id="health-title">Service status</h2>
        </div>
        <div class="actions">
            @if (_snapshot is not null)
            {
                <span class="status @(_snapshot.Ok ? "" : "status-warn")">@(_snapshot.Ok ? "Available" : "Needs attention")</span>
            }
            <button class="button button-ghost" @onclick="RefreshAsync" disabled="@_loading">@(_loading ? "Checking…" : "Refresh")</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="degraded"><strong>Service status is unavailable.</strong> Try refreshing.</div>
        <details class="technical-details"><summary>Error details</summary><pre>@_error</pre></details>
    }
    else if (_snapshot is null)
    {
        <div class="loading">Checking storage and the analysis service…</div>
    }
    else
    {
        <dl class="kv">
            <dt>Audit records stored</dt>
            <dd>@_snapshot.Ledger.Entries.ToString("N0", CultureInfo.InvariantCulture)</dd>
            <dt>Analysis service</dt>
            <dd>
                @if (_snapshot.Classifier.Reachable)
                {
                    <span class="status">Connected</span>
                }
                else
                {
                    <span class="status status-bad">Unavailable</span>
                }
            </dd>
            <dt>Status checked</dt>
            <dd>@Fmt.Utc(_snapshot.CheckedAt)</dd>
        </dl>
        @if (!_snapshot.Classifier.Reachable)
        {
            <div class="degraded">New observations cannot be analysed until the analysis service reconnects. Existing results remain available.</div>
        }
        else if (_snapshot.Classifier.Ready == false)
        {
            <p class="panel-note">The analysis service is reachable. Each request supplies its own historical data, so its empty startup history does not block analysis.</p>
        }
        <details class="technical-details">
            <summary>Connection and build details</summary>
            <dl class="kv">
                <dt>Classifier address</dt><dd>@_snapshot.Classifier.BaseUrl</dd>
                <dt>Engine build</dt><dd class="mono">@_snapshot.EngineVersion</dd>
                <dt>Latest audit sequence</dt><dd>@_snapshot.Ledger.HeadSequence</dd>
                @if (_snapshot.Classifier.Detail is { } detail)
                {
                    <dt>Classifier diagnostic</dt><dd>@detail</dd>
                }
            </dl>
        </details>
    }
</section>

@code {
    private EngineHealthSnapshot? _snapshot;
    private string? _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _snapshot = await HealthService.GetAsync(CancellationToken.None);
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException or Microsoft.Data.Sqlite.SqliteException)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
