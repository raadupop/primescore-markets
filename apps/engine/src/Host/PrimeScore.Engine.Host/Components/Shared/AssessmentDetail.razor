@using PrimeScore.Modules.Classification.Contracts
@using PrimeScore.SharedKernel

<section class="panel" aria-label="Assessment">
    <div class="panel-head">
        <div>
            <div class="kicker">Understand the evidence</div>
            <h2>@(Outcome is { Available: true } ? "How unusual was this observation?" : "Analysis unavailable")</h2>
        </div>
        @if (Outcome is { } recorded)
        {
            <a href="ledger/@recorded.LedgerSequence">View audit record</a>
        }
    </div>
    @if (Outcome is null)
    {
        <p>This observation is waiting for analysis. The engine checks new observations as they arrive and retries pending observations every few minutes.</p>
    }
    else if (!Outcome.Available)
    {
        <p><strong>@AssessmentBadge.Reason(Outcome.Reason).</strong> @UnavailableExplanation(Outcome.Reason)</p>
        <p class="panel-note">Last checked @Fmt.Utc(Outcome.AssessedAt).</p>
        <details class="technical-details">
            <summary>Analysis diagnostic</summary>
            <p>@Outcome.Detail</p>
            <dl class="kv"><dt>Assessment ID</dt><dd>@Outcome.AssessmentId</dd><dt>Correlation ID</dt><dd>@Outcome.CorrelationId</dd></dl>
        </details>
    }
    else
    {
        <div class="metric-grid">
            <div class="metric">
                <span class="metric-label">Severity</span>
                <strong class="metric-value">@Fmt.Signed(Outcome.Score, 2)</strong>
                <p class="panel-note">@SeverityExplanation(Outcome)</p>
            </div>
            <div class="metric">
                <span class="metric-label">Confidence</span>
                <strong class="metric-value">@Fmt.Percent(Outcome.Certainty)</strong>
                <p class="panel-note">Support from the amount and freshness of history, reduced when quality checks fail.</p>
            </div>
            <div class="metric">
                <span class="metric-label">Comparison history</span>
                <strong class="metric-value">@Fmt.Count(Outcome.ReferenceWindowLength)</strong>
                <p class="panel-note">Earlier values available to this assessment@(Outcome.IsFallback ? ", from the reused observation" : "").</p>
            </div>
        </div>
        <p class="panel-note">Severity runs from −1 to +1; a larger magnitude means a more unusual deviation. Confidence is a measure of data support, not the probability of a profitable position.</p>
        @if (Outcome.IsFallback)
        {
            <div class="degraded"><strong>A previous assessment was reused.</strong> @AssessmentBadge.Reason(Outcome.Reason); the assessment was @AssessmentBadge.Stale(Outcome.StalenessSeconds) when reused.</div>
        }
        @foreach (var flag in Outcome.Flags)
        {
            <div class="degraded"><strong>@AssessmentBadge.FlagLabel(flag).</strong> @AssessmentBadge.FlagTitle(flag)</div>
        }
        <dl class="kv">
            <dt>History coverage</dt><dd>@Fmt.Percent(Outcome.HistorySufficiency) of the target history length</dd>
            <dt>History freshness</dt><dd>@Fmt.Percent(Outcome.TemporalRelevance) at the time of the observation</dd>
            <dt>Analysed</dt><dd>@Fmt.Utc(Outcome.AssessedAt)</dd>
            @if (Outcome.Consensus is { } consensus)
            {
                <dt>Consensus estimate</dt>
                <dd>@Fmt.Number(consensus.Value, 4) · <a href="@consensus.Url" target="_blank" rel="noopener noreferrer">@consensus.Source</a> · retrieved @Fmt.Utc(consensus.RetrievedAt)</dd>
            }
        </dl>
        <details class="technical-details">
            <summary>Calculation trace and audit details</summary>
            <dl class="kv">
                <dt>Method</dt><dd>@Fmt.Humanize(Outcome.ClassificationMethod ?? "Unavailable")</dd>
                <dt>Score type</dt><dd>@Fmt.Humanize(Outcome.ScoreType ?? "Unavailable")</dd>
                <dt>Exact severity</dt><dd>@Fmt.Signed(Outcome.Score, 4)</dd>
                <dt>Exact confidence</dt><dd>@Fmt.Number(Outcome.Certainty, 4)</dd>
                <dt>Assessment ID</dt><dd>@Outcome.AssessmentId</dd>
                <dt>Correlation ID</dt><dd>@Outcome.CorrelationId</dd>
                @if (Outcome.EventTaxonomy is { } taxonomy)
                {
                    <dt>Event classification</dt><dd>@Fmt.Humanize(taxonomy)</dd>
                }
                @if (Outcome.IsFallback)
                {
                    <dt>Reused assessment ID</dt><dd>@Outcome.FallbackOf</dd>
                    <dt>Reuse reason</dt><dd>@Outcome.Detail</dd>
                }
            </dl>
            <h3>Reasoning trace</h3>
            <p class="trace">@Outcome.ReasoningTrace</p>
            @if (!string.IsNullOrWhiteSpace(Outcome.ComputedMetrics) && Outcome.ComputedMetrics != "{}")
            {
                <h3>Computed values</h3>
                <pre class="code">@Fmt.Json(Outcome.ComputedMetrics)</pre>
            }
        </details>
    }
</section>

@code {
    [Parameter]
    public AssessmentView? Outcome { get; set; }

    private static string SeverityExplanation(AssessmentView outcome) => outcome.Category switch
    {
        SourceCategory.MarketData => "Positive means above the historical median; negative means below it.",
        SourceCategory.Macroeconomic => "Positive means above the consensus estimate; negative means below it.",
        _ => "The sign shows the direction of the deviation from the comparison baseline.",
    };

    private static string UnavailableExplanation(UnavailableReason? reason) => reason switch
    {
        UnavailableReason.AwaitingConsensus => "A sourced estimate for this release date is needed before its surprise can be measured.",
        UnavailableReason.RouteNotImplemented => "This version records these observations but cannot score them yet.",
        UnavailableReason.ClassifierUnreachable => "Analysis will be retried when the service reconnects.",
        UnavailableReason.InvalidResponse => "The service response failed validation; this observation has no usable assessment.",
        UnavailableReason.ClassifierRejected => "The service could not accept the observation in its current form.",
        UnavailableReason.UnknownIndicator => "The observation cannot be matched to a configured indicator.",
        _ => "No usable assessment is available for this observation.",
    };
}