@using PrimeScore.Modules.Classification.Contracts

@* Everything an assessment was computed from and what it said, traceable to its ledger entry (SRS OBS-002). *@
<section class="panel" aria-label="Assessment">
    <div class="panel-head">
        <div>
            <div class="kicker">Classification · statistical, not a forecast</div>
            <h2>@(Outcome is { Available: true } ? "Assessment" : "No assessment")</h2>
        </div>
        <AssessmentBadge Outcome="Outcome" />
    </div>
    @if (Outcome is null)
    {
        <p class="panel-note">This signal has not been classified yet. Classification runs when a signal is recorded and again every few minutes for anything still pending.</p>
    }
    else if (!Outcome.Available)
    {
        <dl class="kv">
            <dt>Reason</dt><dd>@AssessmentBadge.Reason(Outcome.Reason)</dd>
            <dt>Detail</dt><dd>@Outcome.Detail</dd>
            <dt>Recorded</dt><dd>@Fmt.Utc(Outcome.AssessedAt)</dd>
            <dt>Ledger entry</dt><dd><a href="ledger/@Outcome.LedgerSequence">#@Outcome.LedgerSequence</a></dd>
        </dl>
    }
    else
    {
        <dl class="kv">
            <dt>Severity</dt><dd class="mono">@Fmt.Signed(Outcome.Score, 4) (@Outcome.ScoreType)</dd>
            <dt>Certainty</dt><dd class="mono">@Fmt.Number(Outcome.Certainty, 4)</dd>
            <dt>History sufficiency</dt><dd class="mono">@Fmt.Number(Outcome.HistorySufficiency, 4)</dd>
            <dt>Temporal relevance</dt><dd class="mono">@Fmt.Number(Outcome.TemporalRelevance, 4)</dd>
            <dt>Method</dt><dd>@Outcome.ClassificationMethod</dd>
            @if (Outcome.EventTaxonomy is { } taxonomy)
            {
                <dt>Event taxonomy</dt><dd>@taxonomy</dd>
            }
            @if (Outcome.IsFallback)
            {
                <dt>Reused assessment</dt>
                <dd class="mono">@Outcome.FallbackOf (its window: @Outcome.ReferenceWindowLength value(s) before that earlier signal)</dd>
            }
            else
            {
                <dt>Reference window</dt>
                <dd>@Outcome.ReferenceWindowLength value(s) observed before the signal</dd>
            }
            @if (Outcome.Consensus is { } consensus)
            {
                <dt>Consensus used</dt>
                <dd>
                    <span class="mono">@Fmt.Number(consensus.Value, 4)</span> ·
                    <a href="@consensus.Url" target="_blank" rel="noopener noreferrer">@consensus.Source</a> ·
                    retrieved @Fmt.Utc(consensus.RetrievedAt)
                </dd>
            }
            @if (Outcome.IsFallback)
            {
                <dt>Fallback</dt>
                <dd>Reused after @AssessmentBadge.Reason(Outcome.Reason); @AssessmentBadge.Stale(Outcome.StalenessSeconds). @Outcome.Detail</dd>
            }
            @if (Outcome.Flags.Count > 0)
            {
                <dt>Flags</dt><dd>@string.Join(", ", Outcome.Flags)</dd>
            }
            <dt>Recorded</dt><dd>@Fmt.Utc(Outcome.AssessedAt)</dd>
            <dt>Correlation id</dt><dd>@Outcome.CorrelationId</dd>
            <dt>Ledger entry</dt><dd><a href="ledger/@Outcome.LedgerSequence">#@Outcome.LedgerSequence</a></dd>
        </dl>
        <h3>Reasoning trace</h3>
        <p class="trace">@Outcome.ReasoningTrace</p>
        @if (!string.IsNullOrWhiteSpace(Outcome.ComputedMetrics) && Outcome.ComputedMetrics != "{}")
        {
            <details>
                <summary>Computed metrics</summary>
                <pre class="code">@Fmt.Json(Outcome.ComputedMetrics)</pre>
            </details>
        }
    }
</section>

@code {
    [Parameter]
    public AssessmentView? Outcome { get; set; }
}
