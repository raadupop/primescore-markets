@page "/history"
@using PrimeScore.Modules.Classification.Contracts
@using PrimeScore.Modules.Configuration.Contracts
@using PrimeScore.Modules.Decision.Contracts
@using PrimeScore.SharedKernel
@using PrimeScore.SharedKernel.Cqrs
@inject IQueryHandler<GetCompositeHistory, IReadOnlyList<DailyAggregate>> HistoryQuery
@inject IQueryHandler<GetActiveSettings, SettingsVersion> SettingsQuery
@inject IQueryHandler<GetDecisionOutcomes, IReadOnlyList<DecisionOutcomePoint>> DecisionQuery
@inject IClock Clock

<PageTitle>History · PrimeScore Markets</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Explore the pattern</div>
        <h1>Market history</h1>
        <p>
            Follow the combined signal score and the reference level's place in its own history. Each point is the last analysis recorded for that New York trading day.
            The markers show extreme states; they do not represent trades or forecasts.
        </p>
    </div>
</div>

<div class="filters" role="group" aria-label="History filters">
    <label>
        Range
        <select @bind="Range" @bind:after="LoadAsync">
            <option value="1">Last year</option>
            <option value="5">Last 5 years</option>
            <option value="0">Everything recorded</option>
        </select>
    </label>
    <label>
        Market
        <select @bind="Context" @bind:after="LoadAsync">
            @foreach (var context in _contexts)
            {
                <option value="@context.Name">@Fmt.Context(context.Name) · @context.ReferenceInstrument</option>
            }
        </select>
    </label>
</div>

@if (_error is not null)
{
    <div class="degraded"><strong>The history could not be read.</strong> @_error</div>
}
else if (_days is null)
{
    <div class="loading">Loading the composite history…</div>
}
else if (_days.Count == 0)
{
    <EmptyState Title="No composite recorded for this context">
        A composite is recorded for every classified signal of the context's member instruments. Load history on Sources and health
        (source adapters) or through <span class="mono">POST /api/admin/signals</span>; nothing is estimated in its place.
    </EmptyState>
}
else
{
    <section class="panel" aria-label="Composite and dislocation history">
        <div class="panel-head">
            <div>
                <div class="kicker">@Context context · @Fmt.Count(_days.Count) trading days · @_days[0].Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) to @_days[^1].Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</div>
                <h2>Signal score and level percentile</h2>
            </div>
            <span class="status" title="Days whose final research result passed all configured checks.">@_markers.Count days in an extreme state</span>
        </div>
        <p class="panel-note">Signal score: −1 to +1, where the level sits against its reference median. Level percentile: share of prior closes at or below the level; dashed lines mark the extreme tails. Shading indicates periods of low or high observed volatility.</p>
        <SeriesChart Dates="_dates" Panels="_panels" Runs="_runs" Extras="_extras" Markers="_markers" MarkerLabel="Extreme state"
                     AriaLabel="@($"Daily composite score and dislocation for the {Context} context")"
                     Footnote="@_footnote" />
    </section>
}

@code {
    private IReadOnlyList<ContextSettings> _contexts = [];
    private IReadOnlyList<DailyAggregate>? _days;
    private IReadOnlyList<DateOnly> _dates = [];
    private IReadOnlyList<SeriesPanel> _panels = [];
    private IReadOnlyList<ShadedRun> _runs = [];
    private IReadOnlyList<ExtraColumn> _extras = [];
    private IReadOnlyList<int> _markers = [];
    private string? _footnote;
    private string? _error;
    private double _tail = 0.05;

    [SupplyParameterFromQuery(Name = "context")]
    public string? ContextQuery { get; set; }

    private string Context { get; set; } = "equity";

    private string Range { get; set; } = "5";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var active = (await SettingsQuery.HandleAsync(new GetActiveSettings(), CancellationToken.None)).Settings;
            _contexts = active.Contexts;
            _tail = active.DeployConditions?.FirstOrDefault(condition => condition.Name == DeployConditionNames.LevelPercentileTail)?.Threshold ?? 0.05;
            Context = _contexts.FirstOrDefault(context => string.Equals(context.Name, ContextQuery, StringComparison.OrdinalIgnoreCase))?.Name
                ?? _contexts.FirstOrDefault()?.Name ?? "equity";
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException)
        {
            _error = exception.Message;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var years = int.Parse(Range, CultureInfo.InvariantCulture);
            var from = years > 0 ? Clock.UtcNow.AddYears(-years) : (DateTimeOffset?)null;
            var days = await HistoryQuery.HandleAsync(new GetCompositeHistory(Context, from), CancellationToken.None);
            var decisions = await DecisionQuery.HandleAsync(new GetDecisionOutcomes(Context, from), CancellationToken.None);
            var threshold = _contexts.FirstOrDefault(context => context.Name == Context)?.DislocationThreshold;
            Build(days, threshold, decisions);
            _days = days;
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException or FormatException)
        {
            _error = exception.Message;
        }
    }

    private void Build(IReadOnlyList<DailyAggregate> days, double? threshold, IReadOnlyList<DecisionOutcomePoint> decisions)
    {
        // The day's last decision, matching the day's last composite shown on the chart.
        var lastDecision = decisions
            .GroupBy(decision => SharedKernel.MarketTime.NewYorkDate(decision.AsOf))
            .ToDictionary(day => day.Key, day => day.MaxBy(decision => (decision.AsOf, decision.LedgerSequence))!);
        _dates = days.Select(day => day.Date).ToArray();
        var tail = _tail;
        var references = new[] { new ReferenceLine(1 - tail, $"extreme tail {Fmt.Percent(tail)}"), new ReferenceLine(tail, "") };
        _panels =
        [
            new SeriesPanel("Signal score", "#5b8ef0", days.Select(day => (double?)day.Composite).ToArray(), value => Fmt.Signed(value, 2), -1, 1),
            new SeriesPanel("Level percentile", "#d8692f", days.Select(day => day.RegimePercentile).ToArray(), value => Fmt.Percent(value), 0, 1, references),
        ];
        _runs = Runs(days);
        _extras =
        [
            new ExtraColumn("Observed volatility", index => days[index].MarketObservedIv is { } iv ? Fmt.Number(iv, 2) : "—"),
            new ExtraColumn("Regime · sensitivity", index => days[index].Regime is { } regime ? $"{regime.Replace('_', ' ')} · {Fmt.Number(days[index].SensitivityFactor, 2)}" : "—"),
            new ExtraColumn("State", index => lastDecision.TryGetValue(days[index].Date, out var decision) ? DecisionCopy.Scenario(decision.State) : "—"),
            new ExtraColumn("Research result", index => lastDecision.TryGetValue(days[index].Date, out var decision) ? DecisionCopy.Outcome(decision.Outcome, decision.State) : "—"),
            new ExtraColumn("Config", index => $"v{days[index].ConfigVersion} · {days[index].WeightingSchemeId}"),
        ];
        _markers = Enumerable.Range(0, days.Count)
            .Where(index => lastDecision.TryGetValue(days[index].Date, out var decision) && decision.Outcome == DecisionOutcome.Deploy && !DecisionCopy.IsLegacy(decision.State))
            .ToArray();
        var versions = days.Select(day => day.ConfigVersion).Distinct().Count();
        _footnote = versions > 1
            ? $"{versions} configuration versions over this range; each point used the version in force when it was recorded. Decisions before ADR-0008 used the refuted composite gate."
            : "Dashed lines: the configured extreme tail at each end of the level's history.";
        _footnote += " The percentile ranks the level against its prior closes; it describes where the level sits, not where it goes.";
    }

    /// <summary>Contiguous runs of the low and high regimes; normal is left unshaded.</summary>
    private static ShadedRun[] Runs(IReadOnlyList<DailyAggregate> days)
    {
        var runs = new List<ShadedRun>();
        var start = -1;
        string? kind = null;
        for (var index = 0; index <= days.Count; index++)
        {
            var current = index < days.Count ? days[index].Regime switch { "high_vol" => "high", "low_vol" => "low", _ => null } : null;
            if (current == kind)
            {
                continue;
            }

            if (kind is not null)
            {
                runs.Add(new ShadedRun(start, index - 1, kind));
            }

            (start, kind) = (index, current);
        }

        return [.. runs];
    }
}
