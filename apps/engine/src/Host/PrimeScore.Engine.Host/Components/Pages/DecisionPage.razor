@page "/decisions/{DecisionId:guid}"
@using PrimeScore.Ledger
@using PrimeScore.Modules.Decision.Contracts
@using PrimeScore.SharedKernel.Cqrs
@inject IQueryHandler<GetDecision, DecisionView?> DecisionQuery
@inject IPipelineLogQuery Logs
@inject ILedgerAuditQuery Audit

<PageTitle>Decision analysis · PrimeScore Markets</PageTitle>

@if (_error is not null)
{
    <div class="degraded"><strong>The decision could not be read.</strong> @_error</div>
}
else if (_loading)
{
    <div class="loading">Loading the decision…</div>
}
else if (_decision is not { } decision)
{
    <EmptyState Title="No such decision">No decision @DecisionId is recorded. <a href="decisions">All decisions</a></EmptyState>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">Decision analysis · @Fmt.Context(decision.Context)</div>
            <h1>@DecisionCopy.Scenario(decision.Scenario)</h1>
            <p>Reference: @Fmt.Instrument(decision.ReferenceInstrument) · Observed @Fmt.Utc(decision.AsOf)</p>
        </div>
        <div class="action-bar">
            <DecisionBadge Outcome="decision.Outcome" Scenario="@decision.Scenario" />
            <a class="button" href="decisions">All decisions</a>
        </div>
    </div>

    <WorkflowGuide Current="conditions" />

    <section class="panel analysis-summary" aria-label="Decision summary">
        <h2>@DecisionCopy.Outcome(decision.Outcome, decision.Scenario)</h2>
        <p>@DecisionCopy.Summary(decision)</p>
        <div class="metric-grid">
            <div class="metric"><span>Observed @decision.ReferenceInstrument</span><strong>@Fmt.Number(decision.MarketObservedIv, 2)</strong><small>Index level at this observation</small></div>
            <div class="metric"><span>Place in its own history</span><strong>@(decision.LevelPercentile is { } percentile ? Fmt.Ordinal(percentile * 100) : "—")</strong><small>@DecisionCopy.Percentile(decision.LevelPercentile, decision.Scenario)</small></div>
            <div class="metric"><span>Volatility state</span><strong>@DecisionCopy.Scenario(decision.Scenario)</strong><small>A rank of the level, not a forecast</small></div>
        </div>
        <p class="panel-note">@DecisionCopy.StateMeaning(decision.Scenario)</p>
        <div class="callout">
            <strong>Position: none. Execution: none.</strong>
            This record evaluates @decision.ReferenceInstrument as a reference index. No tradable instrument, contract, side, size or venue was selected, and no order was sent.
        </div>
    </section>

    <section class="panel" aria-label="Conditions">
        <div class="panel-head">
            <div>
                <div class="kicker">@decision.Conditions.Count(condition => condition.Passed) of @decision.Conditions.Count checks passed</div>
                <h2>Why this result?</h2>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Check</th><th>Recorded value</th><th>Requirement</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var condition in decision.Conditions)
                    {
                        <tr>
                            <td><strong>@DecisionCopy.ConditionName(condition.Name)</strong><div class="panel-note">@DecisionCopy.ConditionMeaning(condition.Name)</div></td>
                            <td>@DecisionCopy.ConditionActual(condition)</td>
                            <td>@DecisionCopy.ConditionRequirement(condition)</td>
                            <td>
                                <span class="status @(condition.Passed ? "" : "status-warn")">@(condition.Passed ? "Passed" : "Not met")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="grid grid-2">
        <section class="panel" aria-label="Contributing signals">
            <div class="panel-head">
                <div><div class="kicker">Evidence on the combined score's side</div><h2>Strongest supporting observations</h2></div>
            </div>
            <p class="panel-note">Up to three confirmed signals pointing in the combined score's direction. Open an observation to inspect its source and classification.</p>
            <SignalTable Signals="decision.TopContributing" Empty="No supporting confirmed observation was recorded." />
        </section>
        <section class="panel" aria-label="Dissenting signals">
            <div class="panel-head">
                <div><div class="kicker">Evidence against the combined score</div><h2>Opposing observations</h2></div>
            </div>
            <SignalTable Signals="decision.Dissenting" Empty="No confirmed observation pointed in the opposite direction." />
        </section>
    </div>

    <section class="panel" aria-label="Next steps">
        <h2>Continue the analysis</h2>
        <p>Compare this result with the market's history, inspect the observation that triggered it, or test the settings against historical events.</p>
        <div class="action-bar">
            <a class="button" href="history?context=@Uri.EscapeDataString(decision.Context)">Market history</a>
            <a class="button" href="tape?signal=@decision.TriggerSignalId">Triggering observation</a>
            <a class="button" href="replay">Historical validation</a>
        </div>
    </section>

    <details class="technical-details">
        <summary>Calculation, recorded explanation and audit trail</summary>
    <section class="panel" aria-label="Recorded calculation">
        <div class="panel-head">
            <div>
                <div class="kicker">Stored inputs</div>
                <h2>Calculation and provenance</h2>
            </div>
        </div>
        <dl class="kv">
            <dt>Combined score</dt><dd>@Fmt.Signed(decision.CompositeScore, 4) · −1 to +1; positive means the strongest confirmed input sits above its own median, negative below. A rank, not a direction.</dd>
            <dt>Legacy scenario gap</dt>
            <dd>
                @Fmt.Signed(decision.DislocationValue, 4) index points = @Fmt.Number(decision.SignalImpliedIv, 4) − observed @decision.ReferenceInstrument @Fmt.Number(decision.MarketObservedIv, 2).
                Recorded for reproducibility; it is the level times a rank of the level and no longer gates decisions (ADR-0008).
            </dd>
            <dt>Configuration</dt><dd><a href="configuration">version @decision.ConfigVersion.Value</a></dd>
            <dt>Correlation id</dt><dd>@decision.CorrelationId</dd>
            <dt>Stored outcome</dt><dd>@decision.Outcome.ToString().ToUpperInvariant() · @decision.Scenario</dd>
            <dt>Triggered by</dt><dd><a href="tape?signal=@decision.TriggerSignalId">@decision.TriggerSignalId</a></dd>
            <dt>Recorded</dt><dd>@Fmt.Utc(decision.RecordedAt) · <a href="ledger/@decision.LedgerSequence">ledger #@decision.LedgerSequence</a></dd>
        </dl>
        <h3>Original engine explanation</h3>
        <p>@decision.Explanation</p>
        <div class="table-wrap"><table class="data">
            <thead><tr><th>Stored condition</th><th>Recorded detail</th></tr></thead>
            <tbody>@foreach (var condition in decision.Conditions)
            {
                <tr><td class="mono">@condition.Name</td><td>@condition.Detail</td></tr>
            }</tbody>
        </table></div>
    </section>

    <section class="panel" aria-label="Trace">
        <div class="panel-head">
            <div>
                <div class="kicker">From observation to decision</div>
                <h2>Processing trace</h2>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Stage</th><th>Recorded</th><th>What happened</th><th>Ledger</th></tr></thead>
                <tbody>
                    @foreach (var entry in _trace)
                    {
                        <tr>
                            <td>@entry.Stage</td>
                            <td class="mono">@Fmt.Utc(entry.Timestamp)</td>
                            <td>@entry.Message</td>
                            <td><a href="ledger/@entry.Sequence">#@entry.Sequence</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel" aria-label="Audit chain">
        <div class="panel-head">
            <div>
                <div class="kicker">Record integrity</div>
                <h2>Audit chain segment</h2>
            </div>
            <span class="status @(_chainIntact ? "" : "status-bad")">@(_chainIntact ? "links intact" : "link broken")</span>
        </div>
        <p class="panel-note">
            Each entry's hash covers the previous entry's hash, so changing any earlier entry breaks every later link.
            The full chain is recomputed by the scheduled verification and by <span class="mono">verify-ledger</span> (Sources and health).
        </p>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Sequence</th><th>Kind</th><th>Previous hash</th><th>Hash</th><th>Link</th></tr></thead>
                <tbody>
                    @for (var index = 0; index < _segment.Count; index++)
                    {
                        var entry = _segment[index];
                        var linked = index == 0 || entry.PrevHash == _segment[index - 1].Hash;
                        <tr class="@(entry.Sequence == decision.LedgerSequence ? "selected" : "")">
                            <td class="num"><a href="ledger/@entry.Sequence">#@entry.Sequence</a></td>
                            <td>@entry.Kind</td>
                            <td class="mono">@Short(entry.PrevHash)</td>
                            <td class="mono">@Short(entry.Hash)</td>
                            <td>@(index == 0 ? "" : linked ? "✓ matches #" + _segment[index - 1].Sequence : "✗ does not match")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    </details>
}

@code {
    [Parameter]
    public Guid DecisionId { get; set; }

    private DecisionView? _decision;
    private IReadOnlyList<PipelineLogEntry> _trace = [];
    private IReadOnlyList<LedgerRecord> _segment = [];
    private bool _chainIntact = true;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _decision = await DecisionQuery.HandleAsync(new GetDecision(DecisionId), CancellationToken.None);
            if (_decision is { } decision)
            {
                _trace = await Logs.ByCorrelationAsync(decision.CorrelationId.Value, CancellationToken.None);
                _segment = await Audit.SegmentAsync(Math.Max(1, decision.LedgerSequence - 3), decision.LedgerSequence, CancellationToken.None);
                _chainIntact = _segment.Zip(_segment.Skip(1)).All(pair => pair.Second.PrevHash == pair.First.Hash);
            }
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException)
        {
            _error = exception.Message;
        }

        _loading = false;
    }

    private static string Short(string hash) => hash.Length > 16 ? hash[..16] + "…" : hash;
}
