@page "/tape"
@using PrimeScore.Modules.Classification.Contracts
@using PrimeScore.Modules.Decision.Contracts
@using PrimeScore.Modules.Ingestion.Contracts
@using PrimeScore.SharedKernel
@using PrimeScore.SharedKernel.Cqrs
@inject IQueryHandler<GetSignals, SignalPage> SignalQuery
@inject IQueryHandler<GetRejections, IReadOnlyList<RejectionView>> RejectionQuery
@inject IQueryHandler<GetSignalOutcomes, IReadOnlyDictionary<Guid, AssessmentView>> OutcomeQuery
@inject IQueryHandler<GetSignal, SignalView?> SignalByIdQuery
@inject IQueryHandler<GetDecisions, IReadOnlyList<DecisionView>> DecisionQuery

<PageTitle>Signal analysis · PrimeScore Markets</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Research evidence</div>
        <h1>Signal analysis</h1>
        <p>Explore the observations behind each market scenario. Select an indicator to see its value, source, comparison history and assessment.</p>
    </div>
</div>

<WorkflowGuide Current="signals" />

@if (_selectionError is not null)
{
    <div class="degraded" role="status">@_selectionError</div>
}

@if (_selected is { } detail)
{
    <section class="panel" id="selected-signal" aria-label="Selected observation" tabindex="-1">
        <div class="panel-head">
            <div>
                <div class="kicker">Selected observation · @Fmt.Category(detail.Category)</div>
                <h2>@Fmt.Instrument(detail.Instrument)</h2>
            </div>
            <ProvenanceBadge Provenance="detail.Provenance" />
        </div>
        <div class="metric-grid">
            <div class="metric"><span class="metric-label">Observed value</span><strong class="metric-value">@Fmt.Number(detail.Value, 4)</strong><p class="panel-note">@ValueMeaning(detail)</p></div>
            <div class="metric"><span class="metric-label">Observed at</span><strong class="metric-text">@Fmt.Utc(detail.ObservedAt)</strong><p class="panel-note">Observation time supplied by the source.</p></div>
            <div class="metric"><span class="metric-label">Source</span><strong class="metric-text">@detail.Provenance.Provider</strong>
                @if (detail.Provenance.Url is { } sourceUrl)
                {
                    <p class="panel-note"><a href="@sourceUrl" target="_blank" rel="noopener noreferrer">Open source series</a></p>
                }
            </div>
        </div>
        <div class="action-bar"><a href="ledger/@detail.LedgerSequence">View observation audit record</a></div>
        <details class="technical-details">
            <summary>Source timing, identifiers and original payload</summary>
            <dl class="kv">
            <dt>Signal id</dt><dd>@detail.SignalId</dd>
            <dt>Correlation id</dt><dd>@detail.CorrelationId</dd>
            <dt>Source identifier</dt><dd>@detail.SourceIdentifier</dd>
            <dt>Series</dt><dd>@detail.Variant</dd>
            <dt>Payload type</dt><dd>@detail.PayloadType</dd>
            <dt>Stored by the engine</dt><dd>@Fmt.Utc(detail.RecordedAt)</dd>
            <dt>Provider</dt><dd>@detail.Provenance.Provider</dd>
            @if (detail.Provenance.Url is { } url)
            {
                <dt>Source URL</dt><dd><a href="@url" target="_blank" rel="noopener noreferrer">@url</a></dd>
            }
            @if (detail.Provenance.RetrievedAt is { } retrieved)
            {
                <dt>Retrieved</dt><dd>@Fmt.Utc(retrieved)</dd>
            }
            @if (detail.Provenance.FirstReleased is { } released)
            {
                <dt>First released</dt><dd>@released.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
            }
            @if (detail.Provenance.Derivation is { } derivation)
            {
                <dt>Derivation</dt><dd>@derivation</dd>
            }
            @if (detail.Provenance.Note is { } note)
            {
                <dt>Timing</dt><dd>@note</dd>
            }
            <dt>Ledger entry</dt><dd><a href="ledger/@detail.LedgerSequence">#@detail.LedgerSequence</a></dd>
            </dl>
            <pre class="code">@Fmt.Json(detail.Payload)</pre>
        </details>
    </section>
    @if (Guid.TryParse(AssessmentParameter, out var used) && Outcome(detail) is { } latest && latest.AssessmentId != used)
    {
        <div class="degraded">
            <strong>The decision used an earlier assessment.</strong>
            This page shows the latest stored assessment, which may have replaced a reused result. The original assessment ID was <span class="mono">@used</span>; consult the decision's audit evidence to inspect that record.
        </div>
    }
    <AssessmentDetail Outcome="@Outcome(detail)" />
    <section class="panel" aria-label="Research decisions linked to this observation">
        <div class="panel-head">
            <div>
                <div class="kicker">Follow the evidence</div>
                <h2>Research decisions linked to this observation</h2>
            </div>
        </div>
        @if (_selectedDecisions.Count == 0)
        {
            <p class="panel-note">
                No decision was recorded for this observation. A decision requires an assessed input in a market context and an observed volatility reference.
            </p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th scope="col">Market</th><th scope="col">Research status</th><th scope="col">Combined signal strength</th><th scope="col">Scenario gap</th><th scope="col">Analysis</th></tr></thead>
                    <tbody>
                        @foreach (var decision in _selectedDecisions)
                        {
                            <tr>
                                <td>@Fmt.Context(decision.Context)</td>
                                <td><DecisionBadge Outcome="decision.Outcome" /></td>
                                <td class="num">@Fmt.Signed(decision.CompositeScore, 4)</td>
                                <td class="num">@Fmt.Signed(decision.DislocationValue, 2) points</td>
                                <td><a href="decisions/@decision.DecisionId">Review conditions</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

<section class="panel" aria-label="Filters">
    <div class="panel-head"><h2>Find an observation</h2></div>
    <form class="filters" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
        <label>Input type
            <select @bind="_category">
                <option value="">All</option>
                @foreach (var category in Enum.GetValues<SourceCategory>())
                {
                    <option value="@category">@Fmt.Category(category)</option>
                }
            </select>
        </label>
        <label>Indicator symbol <input @bind="_instrument" placeholder="e.g. VIX" /></label>
        <label>From (UTC) <input type="date" @bind="_from" /></label>
        <label>To (UTC) <input type="date" @bind="_to" /></label>
        <label>Observed by (UTC) <input type="datetime-local" @bind="_asOf" /></label>
        <div class="filter-actions">
            <button class="button button-primary" type="submit">Apply filters</button>
            <button class="button button-ghost" type="button" @onclick="ResetAsync">Clear filters</button>
        </div>
    </form>
    <p class="panel-note">“Observed by” limits observation dates; assessments shown are the latest stored outcomes for those observations.</p>
</section>

@if (_error is not null)
{
    <div class="degraded"><strong>Observations could not be loaded.</strong> @_error</div>
}
else if (_page is null)
{
    <div class="loading">Loading observations…</div>
}
else if (_page.Total == 0)
{
    <EmptyState Title="@(HasFilters ? "No observations match these filters" : "No observations recorded yet")">
        @if (HasFilters)
        {
            <span>Widen the date range or clear the indicator and input type.</span>
        }
        else
        {
            <span>Import market and economic observations from <a href="sources">Data sources</a>.</span>
        }
    </EmptyState>
}
else
{
    <p class="panel-note">
        @Fmt.Count(_page.Total) observations · showing @(_skip + 1)–@(_skip + _page.Signals.Count), newest first.
        Severity describes how unusual an observation is; confidence measures support from its history, not the probability of profit.
    </p>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th scope="col">Observed</th>
                    <th scope="col">Input type</th>
                    <th scope="col">Indicator</th>
                    <th scope="col">Observed value</th>
                    <th scope="col">Assessment</th>
                    <th scope="col">Source</th>
                    <th scope="col">Audit record</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var signal in _page.Signals)
                {
                    <tr class="@(signal.SignalId == _selected?.SignalId ? "selected" : "")">
                        <td class="mono">@Fmt.Utc(signal.ObservedAt)</td>
                        <td>@Fmt.Category(signal.Category)</td>
                        <td><a href="tape?signal=@signal.SignalId#selected-signal">@Fmt.Instrument(signal.Instrument)</a></td>
                        <td class="num">@Fmt.Number(signal.Value, 4)</td>
                        <td><AssessmentBadge Outcome="@Outcome(signal)" /></td>
                        <td><ProvenanceBadge Provenance="signal.Provenance" /></td>
                        <td class="mono"><a href="ledger/@signal.LedgerSequence">#@signal.LedgerSequence</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="action-bar">
        <button class="button button-ghost" disabled="@(_skip == 0)" @onclick="() => PageAsync(-PageSize)">Newer</button>
        <button class="button button-ghost" disabled="@(_skip + PageSize >= _page.Total)" @onclick="() => PageAsync(PageSize)">Older</button>
    </div>
}

<details class="panel technical-details">
    <summary>Rejected observations</summary>
    @if (_rejections is null || _rejections.Count == 0)
    {
        <p class="panel-note">No submission has been rejected.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th scope="col">Recorded</th><th scope="col">Source</th><th scope="col">Errors</th><th scope="col">Ledger</th></tr></thead>
                <tbody>
                    @foreach (var rejection in _rejections)
                    {
                        <tr>
                            <td class="mono">@Fmt.Utc(rejection.RecordedAt)</td>
                            <td class="mono">@(rejection.SourceIdentifier ?? "—")</td>
                            <td>@string.Join("; ", rejection.Errors)</td>
                            <td class="mono"><a href="ledger/@rejection.LedgerSequence">#@rejection.LedgerSequence</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</details>

@code {
    private const int PageSize = 25;

    private string _category = "";
    private string? _instrument;
    private DateTime? _from;
    private DateTime? _to;
    private DateTime? _asOf;
    private int _skip;
    private SignalPage? _page;
    private IReadOnlyDictionary<Guid, AssessmentView> _outcomes = new Dictionary<Guid, AssessmentView>();
    private SignalView? _selected;
    private IReadOnlyList<DecisionView> _selectedDecisions = [];

    /// <summary>Opens one signal's detail, e.g. from a decision's contributing signals.</summary>
    [SupplyParameterFromQuery(Name = "signal")]
    public string? SignalParameter { get; set; }

    /// <summary>The assessment a decision used, to say when the signal's outcome has changed since.</summary>
    [SupplyParameterFromQuery(Name = "assessment")]
    public string? AssessmentParameter { get; set; }
    private IReadOnlyList<RejectionView>? _rejections;
    private string? _error;
    private string? _selectionError;

    private bool HasFilters => _category.Length > 0 || !string.IsNullOrWhiteSpace(_instrument) || _from is not null || _to is not null || _asOf is not null;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _rejections = await RejectionQuery.HandleAsync(new GetRejections(20), CancellationToken.None);
    }

    protected override async Task OnParametersSetAsync()
    {
        _selectionError = null;
        if (Guid.TryParse(SignalParameter, out var id))
        {
            if (_selected?.SignalId == id) { return; }
            _selected = null;
            _selectedDecisions = [];
            try
            {
                if (await SignalByIdQuery.HandleAsync(new GetSignal(id), CancellationToken.None) is { } signal)
                {
                    await SelectAsync(signal);
                }
                else
                {
                    _selectionError = "This observation could not be found. Select an observation from the list below.";
                }
            }
            catch (Microsoft.Data.Sqlite.SqliteException)
            {
                _selected = null;
                _selectionError = "The selected observation could not be loaded. Try opening it again.";
            }
        }
        else
        {
            _selected = null;
            _selectedDecisions = [];
            if (!string.IsNullOrWhiteSpace(SignalParameter))
            {
                _selectionError = "The observation link is invalid. Select an observation from the list below.";
            }
        }
    }

    private async Task SelectAsync(SignalView signal)
    {
        _selected = signal;
        if (!_outcomes.ContainsKey(signal.SignalId))
        {
            var merged = new Dictionary<Guid, AssessmentView>(_outcomes);
            foreach (var (id, outcome) in await OutcomeQuery.HandleAsync(new GetSignalOutcomes([signal.SignalId]), CancellationToken.None))
            {
                merged[id] = outcome;
            }

            _outcomes = merged;
        }

        _selectedDecisions = await DecisionQuery.HandleAsync(new GetDecisions(CorrelationId: signal.CorrelationId, Take: null), CancellationToken.None);
    }

    private Task ApplyAsync()
    {
        _skip = 0;
        return LoadAsync();
    }

    private Task ResetAsync()
    {
        (_category, _instrument, _from, _to, _asOf, _skip) = ("", null, null, null, null, 0);
        return LoadAsync();
    }

    private Task PageAsync(int delta)
    {
        _skip = Math.Max(0, _skip + delta);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _selected = null;
        try
        {
            var filter = new SignalFilter(
                AsOf: Utc(_asOf),
                From: Utc(_from),
                To: _to is { } to ? Utc(to.Date.AddDays(1).AddTicks(-1)) : null,
                Category: Enum.TryParse<SourceCategory>(_category, out var category) ? category : null,
                Instrument: string.IsNullOrWhiteSpace(_instrument) ? null : _instrument.Trim(),
                Skip: _skip,
                Take: PageSize);
            _page = await SignalQuery.HandleAsync(new GetSignals(filter), CancellationToken.None);
            _outcomes = await OutcomeQuery.HandleAsync(new GetSignalOutcomes(_page.Signals.Select(signal => signal.SignalId).ToArray()), CancellationToken.None);
        }
        catch (Microsoft.Data.Sqlite.SqliteException exception)
        {
            _error = exception.Message;
        }
    }

    private AssessmentView? Outcome(SignalView signal) => _outcomes.GetValueOrDefault(signal.SignalId);

    private static string ValueMeaning(SignalView signal) => signal.Instrument switch
    {
        "VIX" or "VVIX" or "VXN" or "RVX" or "OVX" or "GVZ" or "EVZ" => "Volatility index level, in index points.",
        "CPI_YOY" or "CORE_CPI_YOY" or "PCE_YOY" or "CORE_PCE_YOY" => "Year-over-year inflation, in percent.",
        "INITIAL_CLAIMS" or "CONTINUED_CLAIMS" => "Unemployment claims, in people.",
        _ => "Value in the source's published units; see the source series for its definition.",
    };

    private static DateTimeOffset? Utc(DateTime? value) =>
        value is { } local ? new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), TimeSpan.Zero) : null;
}
