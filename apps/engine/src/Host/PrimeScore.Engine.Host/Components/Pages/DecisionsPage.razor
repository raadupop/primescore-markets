@page "/decisions"
@using PrimeScore.Modules.Configuration.Contracts
@using PrimeScore.Modules.Decision.Contracts
@using PrimeScore.SharedKernel.Cqrs
@inject IQueryHandler<GetDecisions, IReadOnlyList<DecisionView>> DecisionQuery
@inject IQueryHandler<GetActiveSettings, SettingsVersion> SettingsQuery

<PageTitle>Decision journal · PrimeScore Markets</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Research · Step 4</div>
        <h1>Decision journal</h1>
        <p>Which observations placed the reference level in an extreme state, and why. Open a record to see its observations, thresholds and analysis.</p>
    </div>
</div>

<WorkflowGuide Current="conditions" />

<div class="callout">
    <strong>These are recorded research decisions.</strong>
    “All checks passed” means the level sat in the extreme tail of its history and the evidence was fresh at the observation
    time. It asserts no direction. Records marked “legacy gate” came from the refuted composite gate (ADR-0008). No order was sent, no position was opened, and no tradable contract, size or trading venue
    was selected. VIX and OVX are reference indices for the analysis.
</div>

<div class="filters" role="group" aria-label="Decision filters">
    <label>
        Market
        <select @bind="_context" @bind:after="LoadAsync">
            <option value="">All markets</option>
            @foreach (var context in _contexts)
            {
                <option value="@context.Name">@Fmt.Context(context.Name) · @context.ReferenceInstrument</option>
            }
        </select>
    </label>
    <label>
        Outcome
        <select @bind="_outcome" @bind:after="LoadAsync">
            <option value="">All outcomes</option>
            <option value="Deploy">Passed (including legacy gate)</option>
            <option value="Idle">Not passed (including legacy gate)</option>
        </select>
    </label>
    <label>
        Observed from (UTC)
        <input type="date" @bind="_from" @bind:after="LoadAsync" />
    </label>
    <label>
        Observed to (UTC)
        <input type="date" @bind="_to" @bind:after="LoadAsync" />
    </label>
</div>

@if (_error is not null)
{
    <div class="degraded"><strong>The decisions could not be read.</strong> @_error</div>
}
else if (_decisions is null)
{
    <div class="loading">Loading decisions…</div>
}
else if (_decisions.Count == 0)
{
    <EmptyState Title="No decision matches">
        Broaden the dates or choose another market. If no history has been loaded, check <a href="sources">Data and health</a>.
    </EmptyState>
}
else
{
    <div class="metric-grid" aria-label="Filtered records">
        <div class="metric"><span>Records shown</span><strong>@Fmt.Count(_decisions.Count)</strong></div>
        <div class="metric"><span>All checks passed</span><strong>@Fmt.Count(_decisions.Count(decision => decision.Outcome == DecisionOutcome.Deploy && !DecisionCopy.IsLegacy(decision.Scenario)))</strong></div>
        <div class="metric"><span>Legacy gate records</span><strong>@Fmt.Count(_decisions.Count(decision => DecisionCopy.IsLegacy(decision.Scenario)))</strong></div>
        <div class="metric"><span>Checks not met</span><strong>@Fmt.Count(_decisions.Count(decision => decision.Outcome == DecisionOutcome.Idle && !DecisionCopy.IsLegacy(decision.Scenario)))</strong></div>
    </div>
    <p class="panel-note">Newest observation first. Each new assessment can create a record, so several records may share a date. Counts describe the filtered records shown, not distinct opportunities or trades.</p>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Observed (UTC)</th><th>Market / reference</th><th>Outcome</th><th>State</th><th>Checks</th><th>Analysis</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var decision in _decisions)
                {
                    <tr>
                        <td class="mono">@Fmt.Utc(decision.AsOf)</td>
                        <td>@Fmt.Context(decision.Context)<div class="panel-note">@decision.ReferenceInstrument</div></td>
                        <td><DecisionBadge Outcome="decision.Outcome" Scenario="@decision.Scenario" /></td>
                        <td>@DecisionCopy.Scenario(decision.Scenario)</td>
                        <td>
                            <strong>@decision.Conditions.Count(condition => condition.Passed) of @decision.Conditions.Count passed</strong>
                            @if (decision.Conditions.Any(condition => !condition.Passed))
                            {
                                <div class="panel-note">Unmet: @string.Join(", ", decision.Conditions.Where(condition => !condition.Passed).Select(condition => DecisionCopy.ConditionName(condition.Name)))</div>
                            }
                        </td>
                        <td><a href="decisions/@decision.DecisionId" aria-label="@($"Open {Fmt.Context(decision.Context)} analysis at {Fmt.Utc(decision.AsOf)}")">View analysis →</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_decisions.Count == Limit)
    {
        <p class="panel-note">Showing the newest @Limit; narrow the dates to see earlier ones.</p>
    }
}

@code {
    private const int Limit = 300;

    private IReadOnlyList<ContextSettings> _contexts = [];
    private IReadOnlyList<DecisionView>? _decisions;
    private string _context = "";
    private string _outcome = "";
    private DateTime? _from;
    private DateTime? _to;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _contexts = (await SettingsQuery.HandleAsync(new GetActiveSettings(), CancellationToken.None)).Settings.Contexts;
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException)
        {
            _error = exception.Message;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var from = _from is { } start ? new DateTimeOffset(DateTime.SpecifyKind(start.Date, DateTimeKind.Unspecified), TimeSpan.Zero) : (DateTimeOffset?)null;
            var to = _to is { } end ? new DateTimeOffset(DateTime.SpecifyKind(end.Date.AddDays(1).AddTicks(-1), DateTimeKind.Unspecified), TimeSpan.Zero) : (DateTimeOffset?)null;
            _decisions = await DecisionQuery.HandleAsync(new GetDecisions(
                from, to,
                _context.Length == 0 ? null : _context,
                Enum.TryParse<DecisionOutcome>(_outcome, out var outcome) ? outcome : null,
                Take: Limit), CancellationToken.None);
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException)
        {
            _error = exception.Message;
        }
    }
}
