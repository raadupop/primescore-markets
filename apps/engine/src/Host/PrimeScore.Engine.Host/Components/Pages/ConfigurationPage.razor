@page "/configuration"
@using PrimeScore.Modules.Configuration.Contracts
@using PrimeScore.SharedKernel.Cqrs
@using PrimeScore.SharedKernel.Json
@inject IQueryHandler<GetActiveSettings, SettingsVersion> ActiveQuery
@inject IQueryHandler<GetSettingsHistory, IReadOnlyList<SettingsVersion>> HistoryQuery
@inject IQueryHandler<ResolveReplaySettings, ReplaySettingsResult> PreviewQuery
@inject ICommandHandler<ReplaceSettings, SettingsChangeAck> SaveCommand
@inject PrimeScore.Engine.Host.Security.UiAccess Access

<PageTitle>Model settings · PrimeScore Markets</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Research settings</div>
        <h1>Model settings</h1>
        <p>
            The rules that turn observations into a market scenario and decide whether its checks pass.
            New settings apply to the next calculation; each existing decision keeps the version it used.
        </p>
    </div>
</div>

@if (_error is not null)
{
    <div class="degraded"><strong>The configuration could not be read.</strong> @_error</div>
}
else if (_active is null)
{
    <div class="loading">Loading the configuration…</div>
}
else
{
    var settings = _active.Settings;
    <section class="panel" aria-label="Active configuration">
        <div class="panel-head">
            <div>
                <div class="kicker">Version @_active.Version.Value · recorded @Fmt.Utc(_active.RecordedAt) by @_active.ChangedBy</div>
                <h2>Current settings</h2>
            </div>
            <span class="status @(settings.Calibration == "uncalibrated default" ? "status-warn" : "status-muted")">@settings.Calibration</span>
        </div>
        <p>@_active.Reason</p>
        <p class="panel-note">Calibration describes how these values were chosen. Default values have not been fitted to establish forecast accuracy; “in-sample” means they were tuned using historical events.</p>
        <div class="action-bar"><a class="button" href="replay">Test settings in a replay</a><a class="button" href="guide">How the analysis works</a></div>
    </section>

    <section class="panel" aria-label="Decision requirements">
        <div class="panel-head"><div><div class="kicker">1 · Review conditions</div><h2>When do the checks pass?</h2></div></div>
        <p>Every requirement must pass for the result to say “Conditions met”. Passing creates a research record; it opens no position and sends no order.</p>
        <div class="table-wrap"><table class="data">
            <thead><tr><th>Check</th><th>Required value</th><th>Meaning</th></tr></thead>
            <tbody>
                @foreach (var condition in settings.DeployConditions ?? [])
                {
                    <tr><td>@DecisionCopy.ConditionName(condition.Name)</td><td>@DecisionCopy.Requirement(condition.Name, condition.Operator, condition.Threshold)</td><td>@DecisionCopy.ConditionMeaning(condition.Name)</td></tr>
                }
                <tr><td>Scenario gap</td><td>At least the market's threshold below</td><td>@DecisionCopy.ConditionMeaning(DeployConditionNames.Dislocation)</td></tr>
                <tr><td>Active waiting periods</td><td>Exactly 0</td><td>@DecisionCopy.ConditionMeaning(DeployConditionNames.Cooldown)</td></tr>
            </tbody>
        </table></div>
    </section>

    <div class="page-head"><div><div class="eyebrow">2 · Market assumptions</div><h2>References, inputs and scenario sensitivity</h2><p>Each market combines its configured inputs around a reference volatility index. A reference index is not a selected trading contract.</p></div></div>
    <div class="grid grid-2">
        @foreach (var context in settings.Contexts)
        {
            <section class="panel" aria-label="@($"{Fmt.Context(context.Name)} settings")">
                <div class="panel-head">
                    <div>
                        <div class="kicker">@Fmt.Instrument(context.ReferenceInstrument)</div>
                        <h2>@Fmt.Context(context.Name)</h2>
                    </div>
                </div>
                <dl class="kv">
                    @foreach (var (category, instruments) in context.Members.OrderBy(pair => pair.Key, StringComparer.Ordinal))
                    {
                        <dt>@Fmt.Category(category)</dt><dd>@string.Join("; ", instruments.Select(Fmt.Instrument))</dd>
                    }
                    <dt>Scenario gap threshold</dt><dd>@Fmt.Number(context.DislocationThreshold, 2) index points in either direction</dd>
                    <dt>Scenario sensitivity</dt>
                    <dd>Low volatility: @Fmt.Number(context.Sensitivity.LowVol, 2) · normal: @Fmt.Number(context.Sensitivity.Normal, 2) · high: @Fmt.Number(context.Sensitivity.HighVol, 2)</dd>
                    <dt>Volatility regime</dt><dd>@Regime(context.Regime)</dd>
                </dl>
                <p class="panel-note">Sensitivity scales how far the combined signal score moves the scenario away from the observed index. These multipliers are model assumptions.</p>
            </section>
        }
    </div>

    <section class="panel" aria-label="Signal combination settings">
        <div class="panel-head"><div><div class="kicker">3 · Combine the evidence</div><h2>Source weights and timing</h2></div></div>
        <p>@Aggregation(settings.Weighting.Aggregation). Category weights set each input group's influence on the combined score.</p>
        <div class="table-wrap"><table class="data">
            <thead><tr><th>Data category</th><th>Weight</th><th>Confirmation window</th><th>Considered fresh for</th></tr></thead>
            <tbody>@foreach (var category in settings.Weighting.CategoryWeights.Keys.Union(settings.CorroborationWindows.Keys).Union(settings.ReportingIntervals.Keys).Order(StringComparer.Ordinal))
            {
                <tr><td>@Fmt.Category(category)</td><td>@(settings.Weighting.CategoryWeights.TryGetValue(category, out var weight) ? Fmt.Number(weight, 3) : "Not configured")</td><td>@(settings.CorroborationWindows.TryGetValue(category, out var window) ? Window(window) : "Not configured")</td><td>@(settings.ReportingIntervals.TryGetValue(category, out var interval) ? Window(interval) : "Not configured")</td></tr>
            }</tbody>
        </table></div>
        <p class="panel-note">The confirmation window limits how far apart observations can support each other. Freshness is the time after a category's latest observation before missing-source handling begins.</p>
        <dl class="kv">
            <dt>Single-signal exception</dt><dd>A signal confirms alone when the magnitude of its directional score is at least @Fmt.Number(settings.BypassPercentile, 4).</dd>
            <dt>Missing-source factors</dt><dd>@string.Join("; ", settings.DropoutSchedule.Select(Tier))</dd>
        </dl>
        <p class="panel-note">Factors reduce a category's contribution after its next observation is overdue. The boundaries above measure seconds overdue; fresh data uses a factor of 1. Missing observations are not estimated.</p>
    </section>

    <section class="panel" aria-label="Advanced configuration">
        <h2>Advanced configuration</h2>
        @if (_canAdmin)
        {
            <details class="technical-details"><summary>Edit parameters (JSON)</summary>
                <p>Saving records a new version, your name and the reason. It affects the next calculation without a restart. Values tuned against the validation set must use calibration “in-sample”.</p>
                <label class="form-field">Configuration JSON<textarea rows="24" class="mono" @bind="_settingsJson"></textarea></label>
                <label class="form-field">Reason for the change<input @bind="_reason" maxlength="500" /></label>
                <div class="action-bar"><button class="button button-primary" disabled="@_saving" @onclick="SaveAsync">Save configuration</button></div>
                @if (_saveMessage is not null) { <p role="status">@_saveMessage</p> }
            </details>
        }
        else
        {
            <p class="panel-note">Administrator access is required to change parameters.</p>
        }
        <details class="technical-details"><summary>Current stored values</summary><pre>@Fmt.Json(CanonicalJson.Serialize(settings))</pre></details>
    </section>

    <section class="panel" aria-label="Configuration versions">
        <div class="panel-head">
            <div>
                <div class="kicker">@_history.Count version(s), newest first</div>
                <h2>Version history</h2>
            </div>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Version</th><th>Saved (UTC)</th><th>By</th><th>Reason</th><th>Recorded changes</th><th>Audit record</th></tr>
                </thead>
                <tbody>
                    @foreach (var version in _history)
                    {
                        <tr>
                            <td class="num">v@(version.Version.Value)</td>
                            <td class="mono">@Fmt.Utc(version.RecordedAt)</td>
                            <td>@version.ChangedBy</td>
                            <td>@version.Reason</td>
                            <td>
                                @if (version.Version.Value == 1)
                                {
                                    <span class="panel-note">Initial defaults · @version.Changes.Count values</span>
                                }
                                else
                                {
                                    <details class="technical-details"><summary>@version.Changes.Count changed values</summary><ul class="changes">
                                        @foreach (var change in version.Changes)
                                        {
                                            <li>@change</li>
                                        }
                                    </ul></details>
                                }
                            </td>
                            <td><a href="ledger/@version.LedgerSequence">#@version.LedgerSequence</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private SettingsVersion? _active;
    private IReadOnlyList<SettingsVersion> _history = [];
    private string? _error;
    private bool _canAdmin, _saving;
    private string _settingsJson = "", _reason = "";
    private string? _saveMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _canAdmin = await Access.AdministratorAsync() is not null;
            _active = await ActiveQuery.HandleAsync(new GetActiveSettings(), CancellationToken.None);
            _settingsJson = Fmt.Json(CanonicalJson.Serialize(_active.Settings));
            _history = await HistoryQuery.HandleAsync(new GetSettingsHistory(), CancellationToken.None);
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException)
        {
            _error = exception.Message;
        }
    }

    private async Task SaveAsync()
    {
        var actor = await Access.AdministratorAsync();
        if (actor is null || _active is null) { _saveMessage = "Administrator sign-in is required."; return; }
        if (string.IsNullOrWhiteSpace(_reason)) { _saveMessage = "Enter a reason for the change."; return; }
        _saving = true;
        try
        {
            var preview = await PreviewQuery.HandleAsync(new ResolveReplaySettings(_active.Version.Value, _settingsJson, MarkInSample: false), CancellationToken.None);
            if (preview.Settings is null) { _saveMessage = string.Join("; ", preview.Errors); return; }
            var ack = await SaveCommand.HandleAsync(new ReplaceSettings(preview.Settings, _reason.Trim(), actor, _active.Version.Value), CancellationToken.None);
            _saveMessage = ack.Accepted ? ack.Version is { } version ? $"Saved version {version}." : "No values changed." : string.Join("; ", ack.Errors);
            if (ack.Accepted) { await OnInitializedAsync(); }
        }
        catch (Exception) { _saveMessage = "The configuration could not be saved. Check the engine log."; }
        finally { _saving = false; }
    }

    private static string Aggregation(Aggregation aggregation) => aggregation switch
    {
        Modules.Configuration.Contracts.Aggregation.WeightedMean => "Use the mean of confirmed weighted signals within each category",
        _ => "Use the strongest confirmed weighted signals in each category, with opposing directions offsetting each other",
    };

    private static string Tier(DropoutTier tier) =>
        tier.BelowSeconds is { } below ? $"factor {Fmt.Number(tier.Factor, 2)} below {Fmt.Number(below, 0)} seconds" : $"factor {Fmt.Number(tier.Factor, 2)} after the final boundary";

    private static string Window(WindowSpan window) => window.TradingDays is { } days
        ? $"{days} {(days == 1 ? "trading day" : "trading days")}" : $"{Fmt.Number(window.Seconds, 0)} seconds";

    private static string Regime(RegimeRule rule) => rule.Mode == RegimeMode.Percentile
        ? $"Low below the {Fmt.Number(rule.LowBelow * 100, 0)}th percentile of historical reference levels; high above the {Fmt.Number(rule.HighAbove * 100, 0)}th percentile; normal in between."
        : $"Low below an index level of {Fmt.Number(rule.LowVolUpper, 2)}; high above {Fmt.Number(rule.HighVolLower, 2)}; normal in between.";
}
