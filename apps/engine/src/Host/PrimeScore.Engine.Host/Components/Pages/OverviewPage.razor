@page "/"
@using PrimeScore.Modules.Analytics.Contracts
@using PrimeScore.Modules.Classification.Contracts
@using PrimeScore.Modules.Configuration.Contracts
@using PrimeScore.Modules.Decision.Contracts
@using PrimeScore.Modules.Ingestion.Contracts
@using PrimeScore.SharedKernel
@using PrimeScore.SharedKernel.Cqrs
@inject IQueryHandler<GetObservationSeries, ObservationSeries> SeriesQuery
@inject IQueryHandler<GetSignal, SignalView?> SignalQuery
@inject IQueryHandler<GetActiveSettings, SettingsVersion> SettingsQuery
@inject IQueryHandler<GetComposite, CompositeView?> CompositeQuery
@inject IQueryHandler<GetDislocation, DislocationView?> DislocationQuery
@inject IQueryHandler<GetDecisions, IReadOnlyList<DecisionView>> DecisionQuery
@inject IQueryHandler<GetForwardOutcomes, ForwardOutcomesReport?> OutcomesQuery
@inject IClock Clock

<PageTitle>Market overview · PrimeScore Markets</PageTitle>
<div class="page-head">
    <div><div class="eyebrow">Research workspace</div><h1>Understand the market. Trace the signal.</h1>
        <p>Place today's reference level in its own history, inspect the evidence and conditions behind the result, then read what happened after similar states.</p></div>
    <a class="button button-ghost" href="guide">How it works →</a>
</div>
<WorkflowGuide />
@if (_error is not null)
{
    <div class="degraded" role="alert"><strong>The overview could not be read.</strong> @_error</div>
}
else if (_cards is null)
{
    <div class="loading">Loading market analysis…</div>
}
else if (_cards.Count == 0)
{
    <EmptyState Title="No markets configured">Add a market in <a href="configuration">Model settings</a> to begin.</EmptyState>
}
else
{
    <div class="market-selector" role="group" aria-label="Choose a market">
        @foreach (var item in _cards)
        {
            <button class="market-choice @(_selected == item.Context.Name ? "selected" : "")" aria-pressed="@(_selected == item.Context.Name ? "true" : "false")"
                    @onclick="() => _selected = item.Context.Name">
                <span class="kicker">@item.Context.ReferenceInstrument reference index</span>
                <strong>@Fmt.Context(item.Context.Name)</strong>
                <span>@(item.Decision is { } decision ? DecisionCopy.Scenario(decision.Scenario) : "Awaiting analysis")</span>
            </button>
        }
    </div>
    var card = _cards.FirstOrDefault(item => item.Context.Name == _selected) ?? _cards[0];
    @if (card.Decision is { } analysis)
    {
        var history = card.Dislocation is { } matching && matching.DislocationId == analysis.DislocationId ? matching.RegimeHistory : (int?)null;
        <section class="panel market-analysis" aria-label="Latest completed market analysis">
            <div class="panel-head">
                <div><div class="kicker">Latest completed analysis · @Fmt.Instrument(analysis.ReferenceInstrument)</div>
                    <h2>@DecisionCopy.Scenario(analysis.Scenario)</h2>
                    <p class="analysis-date">As of @Fmt.Utc(analysis.AsOf) · @Fmt.Age(analysis.AsOf, Clock.UtcNow)</p></div>
                <DecisionBadge Outcome="analysis.Outcome" Scenario="@analysis.Scenario" />
            </div>
            <div class="scenario-comparison">
                <div class="scenario-value"><span class="kicker">Observed market level</span><strong>@Fmt.Number(analysis.MarketObservedIv)</strong><span>@analysis.ReferenceInstrument index points</span></div>
                <div class="comparison-arrow" aria-hidden="true">→</div>
                <div class="scenario-value"><span class="kicker">Place in its own history</span><strong>@(analysis.LevelPercentile is { } percentile ? Fmt.Ordinal(percentile * 100) : "—")</strong><span>@DecisionCopy.Percentile(analysis.LevelPercentile, analysis.Scenario, history)</span></div>
                <div class="scenario-gap"><span class="kicker">Volatility state</span><strong>@DecisionCopy.Scenario(analysis.Scenario)</strong>
                    <span>Extreme tail: @(analysis.Conditions.FirstOrDefault(condition => condition.Name == DeployConditionNames.LevelPercentileTail) is { } tail ? DecisionCopy.ConditionRequirement(tail) : "not configured")</span></div>
            </div>
            <p class="scenario-explanation">@DecisionCopy.StateMeaning(analysis.Scenario) The state is a rank of the level in its own history; it is not a predicted level or an option quote.</p>
            <div class="analysis-summary">
                <div><span class="kicker">Research result</span><h3>@DecisionCopy.Summary(analysis)</h3>
                    <p>@analysis.Conditions.Count(condition => condition.Passed) of @analysis.Conditions.Count checks passed · combined signal score @Fmt.Signed(analysis.CompositeScore, 2)</p></div>
                <a class="button button-primary" href="decisions/@analysis.DecisionId">Read this analysis →</a>
            </div>
            <dl class="position-strip"><div><dt>Instrument monitored</dt><dd>@analysis.ReferenceInstrument volatility index</dd></div><div><dt>Position / execution</dt><dd>No position opened</dd></div><div><dt>Contract / size</dt><dd>Not selected by this model</dd></div></dl>
        </section>
        @if (card.Latest is { } newer && newer.ObservedAt > analysis.AsOf)
        {
            <div class="degraded">Newer source data is available (@Fmt.Utc(newer.ObservedAt)). This completed analysis uses the earlier inputs shown above.</div>
        }
        <div class="grid grid-2">
            <section class="panel"><div class="panel-head"><div><div class="kicker">Evidence</div><h2>What supports this state?</h2></div></div>
                @if (analysis.TopContributing.Count == 0)
                { <p>No confirmed supporting signals were recorded for this analysis.</p> }
                else
                {
                    <ul class="evidence-list">
                        @foreach (var signal in analysis.TopContributing.Take(3))
                        {
                            <li><div><a href="tape?signal=@signal.SignalId&amp;assessment=@signal.AssessmentId">@Fmt.Instrument(signal.Instrument) →</a><small>@Fmt.Category(signal.Category) · @Fmt.Date(signal.ObservedAt)</small></div><div class="evidence-value">@Fmt.Signed(signal.Conviction, 2)<small>weighted signal</small></div></li>
                        }
                    </ul>
                }
                <p class="panel-note">@analysis.Dissenting.Count opposing signal(s) recorded. Confidence measures the classification, not the chance of a profitable trade.</p>
                <div class="action-bar"><a href="decisions/@analysis.DecisionId">View supporting and opposing evidence →</a></div>
            </section>
            <section class="panel"><div class="panel-head"><div><div class="kicker">Coverage &amp; assumptions</div><h2>What is this based on?</h2></div></div>
                @if (card.Composite is { } composite && composite.CompositeId == analysis.CompositeId)
                {
                    <ul class="coverage-list">
                        @foreach (var category in composite.Contributing)
                        { <li><span>@Fmt.Category(category.Category)</span><strong>@category.ConfirmedAssessments.Count confirmed signal(s)</strong></li> }
                        @foreach (var absent in composite.Absent)
                        { <li><span>@Fmt.Category(absent.Category)</span><span class="muted-cell">Not included</span></li> }
                    </ul>
                    @if (composite.Absent.Count > 0)
                    { <details class="technical-details"><summary>Why some evidence is missing</summary>@foreach (var absent in composite.Absent) { <p><strong>@Fmt.Category(absent.Category):</strong> @absent.Reason</p> }</details> }
                }
                else { <p>Coverage for this snapshot is listed with its recorded conditions.</p> }
                <p class="panel-note">Configuration v@(analysis.ConfigVersion.Value). The state is a rank of the reference level; no predictive model has been established. <a href="configuration">Review assumptions</a>.</p>
                <div class="action-bar"><a href="history?context=@card.Context.Name">Explore this market over time →</a></div>
            </section>
        </div>
        @if (card.Dislocation is { } calculation && calculation.DislocationId == analysis.DislocationId)
        {
            <details class="panel technical-details"><summary>How these numbers were calculated</summary>
                <p>Level percentile: share of the previous @Fmt.Count(calculation.RegimeHistory) @calculation.ReferenceInstrument closes at or below @Fmt.Number(calculation.MarketObservedIv) = @(calculation.RegimePercentile is { } p ? Fmt.Number(p, 4) : "—") (@Fmt.Humanize(calculation.Regime) regime).</p>
                <p>Legacy scenario arithmetic, recorded but not used by the decision (ADR-0008): observed @Fmt.Number(calculation.MarketObservedIv) × (1 + signal score @Fmt.Signed(calculation.CompositeScore, 4) × sensitivity @Fmt.Number(calculation.SensitivityFactor)) = @Fmt.Number(calculation.SignalImpliedIv); gap @Fmt.Signed(calculation.DislocationValue, 2) index points. The gap is the level times a rank of the level and carries no independent information.</p>
                <p>Reference observation: @Fmt.Utc(calculation.IvObservedAt). <a href="ledger/@calculation.LedgerSequence">Open calculation audit record →</a></p>
            </details>
        }
    }
    else
    {
        <section class="panel"><h2>@Fmt.Context(card.Context.Name) · awaiting analysis</h2>
            @if (card.Latest is { } observation)
            { <p>Latest @card.Context.ReferenceInstrument observation: @Fmt.Number(observation.Value) at @Fmt.Utc(observation.ObservedAt). There is no completed condition check yet.</p> }
            else { <p>No reference observation is recorded for @card.Context.ReferenceInstrument.</p> }
            <div class="actions"><a class="button button-primary" href="sources">Check data sources →</a><a class="button button-ghost" href="tape">Inspect signals</a></div>
        </section>
    }
    <section class="research-note"><div><strong>Outcomes record</strong>
        @if (card.Outcomes is { DeployDays: > 0 } outcomes && outcomes.Horizons.FirstOrDefault(row => row.TradingDays == 21) is { DeployCount: > 0 } month)
        {
            <p>@Fmt.Count(month.DeployCount) of @Fmt.Count(outcomes.DeployDays) extreme-state days have a 21-day outcome; the @card.Context.ReferenceInstrument had moved back toward its median on @Fmt.Percent(month.DeployRevertShare) of them. Index changes in sample, not trading returns@(card.Context.ReferenceInstrument == "VIX" ? ": the VIX futures test found this reversion priced." : "; no futures test covers this market.")</p>
        }
        else if (card.Outcomes is { Days: > 0 } recorded)
        { <p>@Fmt.Count(recorded.Days) decision days measured, @Fmt.Count(recorded.LegacyDays) of them under the refuted gate. No extreme state under the current gate has a 21-day outcome yet; nothing is estimated.</p> }
        else
        { <p>No decision has a later reference close yet. The record fills in as observations arrive; nothing is estimated.</p> }
    </div><a class="button button-ghost" href="outcomes?context=@card.Context.Name">Read the record →</a></section>
}

@code {
    private sealed record Card(ContextSettings Context, SignalView? Latest, CompositeView? Composite, DislocationView? Dislocation, DecisionView? Decision, ForwardOutcomesReport? Outcomes);
    private List<Card>? _cards;
    private string _selected = "equity";
    private string? _error;
    [SupplyParameterFromQuery(Name = "context")] public string? ContextQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SettingsQuery.HandleAsync(new GetActiveSettings(), CancellationToken.None);
            var cards = new List<Card>();
            foreach (var context in settings.Settings.Contexts)
            {
                var series = await SeriesQuery.HandleAsync(new GetObservationSeries(context.ReferenceInstrument, SourceCategory.MarketData, "IMPLIED_VOLATILITY", DateTimeOffset.MaxValue, 1), CancellationToken.None);
                var latest = series.Points is [var point] ? await SignalQuery.HandleAsync(new GetSignal(point.SignalId), CancellationToken.None) : null;
                var composite = await CompositeQuery.HandleAsync(new GetComposite(context.Name), CancellationToken.None);
                var dislocation = await DislocationQuery.HandleAsync(new GetDislocation(context.Name), CancellationToken.None);
                var decision = (await DecisionQuery.HandleAsync(new GetDecisions(Context: context.Name, Take: 1), CancellationToken.None)).FirstOrDefault();
                var outcomes = await OutcomesQuery.HandleAsync(new GetForwardOutcomes(context.Name), CancellationToken.None);
                cards.Add(new Card(context, latest, composite, dislocation, decision, outcomes));
            }
            _cards = cards;
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException or IOException)
        { _error = exception.Message; }
    }

    protected override void OnParametersSet()
    {
        if (_cards?.Any(card => card.Context.Name == ContextQuery) == true) { _selected = ContextQuery!; }
    }
}
