@page "/"
@using PrimeScore.Modules.Classification.Contracts
@using PrimeScore.Modules.Configuration.Contracts
@using PrimeScore.Modules.Decision.Contracts
@using PrimeScore.Modules.Ingestion.Contracts
@using PrimeScore.SharedKernel
@using PrimeScore.SharedKernel.Cqrs
@inject IQueryHandler<GetObservationSeries, ObservationSeries> SeriesQuery
@inject IQueryHandler<GetSignal, SignalView?> SignalQuery
@inject IQueryHandler<GetSignalOutcomes, IReadOnlyDictionary<Guid, AssessmentView>> OutcomeQuery
@inject IQueryHandler<GetActiveSettings, SettingsVersion> SettingsQuery
@inject IQueryHandler<GetComposite, CompositeView?> CompositeQuery
@inject IQueryHandler<GetDislocation, DislocationView?> DislocationQuery
@inject IQueryHandler<GetCompositeHistory, IReadOnlyList<DailyAggregate>> HistoryQuery
@inject IQueryHandler<GetDecisions, IReadOnlyList<DecisionView>> DecisionQuery
@inject IClock Clock

<PageTitle>Overview · PrimeScore Markets</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Overview</div>
        <h1>Volatility contexts</h1>
        <p>
            Per reference instrument: the latest observed implied volatility, the composite of classified signals and the
            signal-implied scenario, each traceable to its ledger entry. Statistical classification, not a forecast.
        </p>
    </div>
</div>

@if (_error is not null)
{
    <div class="degraded"><strong>The overview could not be read.</strong> @_error</div>
}
else if (_cards is null)
{
    <div class="loading">Loading the latest observations and composites…</div>
}
else
{
    <div class="grid grid-2">
        @foreach (var card in _cards)
        {
            <section class="panel" aria-label="@card.Context.Name context">
                <div class="panel-head">
                    <div>
                        <div class="kicker">@card.Context.Name context · reference @card.Context.ReferenceInstrument</div>
                        <h2>@Title(card.Context)</h2>
                    </div>
                    @if (card.Dislocation is { } scenario)
                    {
                        var (css, label) = Scenario(scenario.DislocationValue);
                        <span class="status @css"
                              title="Sign of the signal-implied dislocation; the magnitude is compared with the threshold. An uncalibrated multiplier, not an independent volatility forecast.">
                            @label
                        </span>
                    }
                    else
                    {
                        <span class="status status-muted">no scenario yet</span>
                    }
                </div>

                @if (card.Latest is { } latest)
                {
                    <div class="figure">@Fmt.Number(latest.Value)</div>
                    <div class="figure-label">
                        @card.Context.ReferenceInstrument implied volatility, close observed @Fmt.Utc(latest.ObservedAt) (@Fmt.Age(latest.ObservedAt, Clock.UtcNow)) ·
                        <ProvenanceBadge Provenance="latest.Provenance" /> ·
                        <a href="ledger/@latest.LedgerSequence">ledger #@latest.LedgerSequence</a> ·
                        <AssessmentBadge Outcome="@_outcomes.GetValueOrDefault(latest.SignalId)" />
                    </div>
                }
                else
                {
                    <EmptyState Title="No observations yet">
                        No @card.Context.ReferenceInstrument close has been recorded. Run the FRED pull from Sources and health; nothing is estimated in its place.
                    </EmptyState>
                }

                @if (card.Composite is { } composite)
                {
                    <div class="metrics">
                        <div class="metric">
                            <div class="kicker">Composite</div>
                            <div class="figure">@Fmt.Signed(composite.Score, 4)</div>
                            <div class="figure-label"><a href="ledger/@composite.LedgerSequence">ledger #@composite.LedgerSequence</a></div>
                        </div>
                        @if (card.Dislocation is { } dislocation)
                        {
                            <div class="metric">
                                <div class="kicker">Dislocation</div>
                                <div class="figure">@Fmt.Signed(dislocation.DislocationValue, 2)</div>
                                <div class="figure-label">
                                    @(dislocation.ThresholdBreached ? "breaches" : "within") ±@Fmt.Number(dislocation.Threshold, 2) ·
                                    <a href="ledger/@dislocation.LedgerSequence">ledger #@dislocation.LedgerSequence</a>
                                </div>
                            </div>
                            <div class="metric">
                                <div class="kicker">Signal-implied IV</div>
                                <div class="figure">@Fmt.Number(dislocation.SignalImpliedIv, 2)</div>
                                <div class="figure-label">@dislocation.Regime.Replace('_', ' ') regime, k = @Fmt.Number(dislocation.SensitivityFactor, 2)</div>
                            </div>
                        }
                    </div>
                    @if (card.Dislocation is not null)
                    {
                        <p class="panel-note">
                            Scenario IV = observed IV × (1 + composite × k). Scenarios use an uncalibrated multiplier, not an independent volatility forecast.
                        </p>
                    }
                    <dl class="kv">
                        <dt>As of</dt>
                        <dd>@Fmt.Utc(composite.AsOf) · configuration v@(composite.ConfigVersion.Value) · @composite.WeightingSchemeId</dd>
                        @foreach (var category in composite.Contributing)
                        {
                            <dt>@Fmt.Category(category.Category)</dt>
                            <dd>
                                @Fmt.Signed(category.WeightedContribution, 4) of the composite ·
                                net conviction @Fmt.Signed(category.NetConviction, 4) · @category.ConfirmedAssessments.Count confirmed
                                @if (category.Discount < 1)
                                {
                                    <span class="status status-warn">overdue by @Fmt.Duration(category.StalenessSeconds) · d = @Fmt.Number(category.Discount, 2)</span>
                                }
                            </dd>
                        }
                        @foreach (var absent in composite.Absent)
                        {
                            <dt>@Fmt.Category(absent.Category)</dt>
                            <dd class="muted-cell">absent: @absent.Reason</dd>
                        }
                        <dt>Latest decision</dt>
                        <dd class="muted-cell">
                            @if (card.Decision is { } decision)
                            {
                                <DecisionBadge Outcome="decision.Outcome" />
                                <span> @FirstSentence(decision.Explanation) · as of @Fmt.Utc(decision.AsOf) ·
                                    <a href="ledger/@decision.LedgerSequence">ledger #@decision.LedgerSequence</a> ·
                                    <a href="decisions/@decision.DecisionId">explore</a></span>
                                @if (card.Dislocation is { } current && decision.DislocationId != current.DislocationId)
                                {
                                    <span class="status status-warn">decision pending for the newest dislocation</span>
                                }
                            }
                            else
                            {
                                <span>none recorded yet</span>
                            }
                        </dd>
                    </dl>
                    @if (card.History.Count > 1)
                    {
                        var span = SparkSpan(card.History, composite.AsOf);
                        <div class="kicker sparkline-title">@span</div>
                        <SeriesChart Compact="true" Dates="card.History.Select(day => day.Date).ToArray()"
                                     Panels="SparkPanels(card.History)"
                                     AriaLabel="@($"Composite and dislocation, {span.ToLowerInvariant()}, for the {card.Context.Name} context")" />
                        <p class="panel-note"><a href="history?context=@card.Context.Name">Full history and table</a></p>
                    }
                }
                else if (card.Latest is not null)
                {
                    <p class="panel-note">
                        No composite yet: one is recorded for every classified signal of this context's member instruments.
                        Classification runs when a signal is recorded and every few minutes for anything pending.
                    </p>
                }
            </section>
        }
    </div>
}

<HealthPanel />

@code {
    private sealed record Card(
        ContextSettings Context,
        SignalView? Latest,
        CompositeView? Composite,
        DislocationView? Dislocation,
        IReadOnlyList<DailyAggregate> History,
        DecisionView? Decision);

    private List<Card>? _cards;
    private IReadOnlyDictionary<Guid, AssessmentView> _outcomes = new Dictionary<Guid, AssessmentView>();
    private string? _error;

    private static string Title(ContextSettings context) => context.Name switch
    {
        "equity" => "US equity implied volatility",
        "oil" => "Crude oil implied volatility",
        _ => $"{context.ReferenceInstrument} implied volatility",
    };

    private static string FirstSentence(string text) => text.IndexOf(". ", StringComparison.Ordinal) is var end and > 0 ? text[..end] : text;

    /// <summary>Lime for expansion, blue for compression (brief §9.7); a zero dislocation is neither.</summary>
    private static (string Css, string Label) Scenario(double dislocation) => dislocation switch
    {
        > 0 => ("", "vol-expansion scenario"),
        < 0 => ("status-blue", "vol-compression scenario"),
        _ => ("status-muted", "no scenario (composite 0)"),
    };

    /// <summary>"Five years" only when the history reaches back that far (a week's slack for holidays).</summary>
    private static string SparkSpan(IReadOnlyList<DailyAggregate> history, DateTimeOffset asOf) =>
        history[0].Date <= DateOnly.FromDateTime(asOf.AddYears(-5).UtcDateTime).AddDays(7)
            ? "Five years"
            : $"Since {history[0].Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";

    private static IReadOnlyList<SeriesPanel> SparkPanels(IReadOnlyList<DailyAggregate> history) =>
    [
        new SeriesPanel("Composite", "#5b8ef0", history.Select(day => (double?)day.Composite).ToArray(), value => Fmt.Signed(value, 2), -1, 1),
        new SeriesPanel("Dislocation", "#d8692f", history.Select(day => day.DislocationValue).ToArray(), value => Fmt.Signed(value, 2), 0, 0),
    ];

    /// <summary>The newest close is chosen exactly as the classifier's window chooses it; the composite is the newest recorded.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SettingsQuery.HandleAsync(new GetActiveSettings(), CancellationToken.None);
            var cards = new List<Card>();
            foreach (var context in settings.Settings.Contexts)
            {
                var series = await SeriesQuery.HandleAsync(
                    new GetObservationSeries(context.ReferenceInstrument, SourceCategory.MarketData, "IMPLIED_VOLATILITY", DateTimeOffset.MaxValue, 1),
                    CancellationToken.None);
                var latest = series.Points is [var point] ? await SignalQuery.HandleAsync(new GetSignal(point.SignalId), CancellationToken.None) : null;
                var composite = await CompositeQuery.HandleAsync(new GetComposite(context.Name), CancellationToken.None);
                var dislocation = await DislocationQuery.HandleAsync(new GetDislocation(context.Name), CancellationToken.None);
                var history = composite is null
                    ? []
                    : await HistoryQuery.HandleAsync(new GetCompositeHistory(context.Name, composite.AsOf.AddYears(-5)), CancellationToken.None);
                var decision = (await DecisionQuery.HandleAsync(new GetDecisions(Context: context.Name, Take: 1), CancellationToken.None)).FirstOrDefault();
                cards.Add(new Card(context, latest, composite, dislocation, history, decision));
            }

            var ids = cards.Select(card => card.Latest).OfType<SignalView>().Select(signal => signal.SignalId).ToArray();
            _outcomes = await OutcomeQuery.HandleAsync(new GetSignalOutcomes(ids), CancellationToken.None);
            _cards = cards;
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException or IOException)
        {
            _error = exception.Message;
        }
    }
}
