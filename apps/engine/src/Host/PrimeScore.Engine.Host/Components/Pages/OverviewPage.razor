@page "/"
@using PrimeScore.Modules.Ingestion.Contracts
@using PrimeScore.SharedKernel
@using PrimeScore.SharedKernel.Cqrs
@inject IQueryHandler<GetObservationSeries, ObservationSeries> SeriesQuery
@inject IQueryHandler<GetSignal, SignalView?> SignalQuery
@inject IClock Clock

<PageTitle>Overview · PrimeScore Markets</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Overview</div>
        <h1>Volatility contexts</h1>
        <p>
            Per reference instrument: the latest observed implied volatility, the composite of classified signals,
            the signal-implied scenario and the decision the rules would have recorded, each traceable to its ledger entry.
        </p>
    </div>
</div>

<div class="grid grid-2">
    @foreach (var context in Contexts)
    {
        <section class="panel" aria-label="@context.Name context">
            <div class="panel-head">
                <div>
                    <div class="kicker">@context.Name context · reference @context.Reference</div>
                    <h2>@context.Title</h2>
                </div>
                @if (_latest.TryGetValue(context.Reference, out var observed) && observed is not null)
                {
                    <span class="status" title="Observed value, not a forecast.">observed</span>
                }
                else
                {
                    <span class="status status-muted">no data</span>
                }
            </div>
            @if (_loading)
            {
                <div class="loading">Loading the latest observation…</div>
            }
            else if (_error is not null)
            {
                <div class="degraded"><strong>The latest observation could not be read.</strong> @_error</div>
            }
            else if (_latest.TryGetValue(context.Reference, out var latest) && latest is not null)
            {
                <div class="figure">@Fmt.Number(latest.Value)</div>
                <div class="figure-label">
                    @context.Reference implied volatility, close observed @Fmt.Utc(latest.ObservedAt) (@Fmt.Age(latest.ObservedAt, Clock.UtcNow)) ·
                    <ProvenanceBadge Provenance="latest.Provenance" /> ·
                    <a href="ledger/@latest.LedgerSequence">ledger #@latest.LedgerSequence</a>
                </div>
                <p class="panel-note">
                    Composite, scenario and decision for this context are not computed yet: classification arrives in milestone M2,
                    aggregation in M3 and decisions in M4. Nothing is estimated in their place.
                </p>
            }
            else
            {
                <EmptyState Title="No observations yet">
                    No @context.Reference close has been recorded. Run the FRED pull from Sources and health; nothing is estimated in its place.
                </EmptyState>
            }
        </section>
    }
</div>

<HealthPanel />

@code {
    private sealed record ContextCard(string Name, string Reference, string Title);

    private static readonly ContextCard[] Contexts =
    [
        new("equity", "VIX", "US equity implied volatility"),
        new("oil", "OVX", "Crude oil implied volatility"),
    ];

    private readonly Dictionary<string, SignalView?> _latest = new(StringComparer.Ordinal);
    private bool _loading = true;
    private string? _error;

    /// <summary>The newest implied-volatility close, chosen exactly as the classifier's window chooses it.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            foreach (var context in Contexts)
            {
                var series = await SeriesQuery.HandleAsync(
                    new GetObservationSeries(context.Reference, SourceCategory.MarketData, "IMPLIED_VOLATILITY", DateTimeOffset.MaxValue, 1),
                    CancellationToken.None);
                _latest[context.Reference] = series.Points is [var point]
                    ? await SignalQuery.HandleAsync(new GetSignal(point.SignalId), CancellationToken.None)
                    : null;
            }
        }
        catch (Exception exception) when (exception is Microsoft.Data.Sqlite.SqliteException or InvalidOperationException or IOException)
        {
            _error = exception.Message;
        }

        _loading = false;
    }
}
