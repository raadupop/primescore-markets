@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="wordmark" href="" aria-label="PrimeScore Markets overview">
            <span class="logo-mark" aria-hidden="true">
                <svg viewBox="0 0 32 36" fill="currentColor"><path d="M2 24h6v10H2z M13 13h6v21h-6z M24 2h6v32h-6z" /></svg>
            </span>PrimeScore<span class="wordmark-product">Markets</span>
        </a>
        <div class="topbar-meta">
            <span class="status" title="SRS POS-003: no orders are placed; decisions are recorded, not executed.">Simulation mode</span>
        </div>
    </header>

    <nav class="sidebar" aria-label="Screens">
        <span class="nav-group">Intelligence</span>
        <NavLink href="" Match="NavLinkMatch.All"><span class="nav-index">01</span>Overview</NavLink>
        <NavLink href="tape"><span class="nav-index">02</span>Signal tape</NavLink>
        <NavLink href="history"><span class="nav-index">03</span>History</NavLink>
        <NavLink href="decisions"><span class="nav-index">04</span>Decisions</NavLink>
        <span class="nav-group">Analysis</span>
        <NavLink href="replay"><span class="nav-index">05</span>Replay</NavLink>
        <span class="nav-group">Operations</span>
        <NavLink href="configuration"><span class="nav-index">06</span>Configuration</NavLink>
        <NavLink href="sources"><span class="nav-index">07</span>Sources and health</NavLink>
    </nav>

    <main class="content" id="main">
        @Body
    </main>

    <footer class="footnote">
        Research tool for options volatility. Observations, statistical classifications, scenarios and decisions are shown separately;
        a scenario is arithmetic under a stated assumption, not a forecast, and nothing here is evidence of profitability.
    </footer>
</div>
