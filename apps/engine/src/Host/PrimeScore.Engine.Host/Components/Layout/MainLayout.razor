@inherits LayoutComponentBase
@inject NavigationManager Navigation

<a class="skip-link" href="#main">Skip to content</a>
<div class="shell">
    <header class="topbar">
        <a class="wordmark" href="@BrandUrl" aria-label="PrimeScore AI home">
            <span class="logo-mark" aria-hidden="true">
                <svg viewBox="0 0 32 36" fill="currentColor"><path d="M2 24h6v10H2z M13 13h6v21h-6z M24 2h6v32h-6z" /></svg>
            </span><span>PrimeScore AI</span><span class="wordmark-product">Markets</span>
        </a>
        <div class="topbar-meta">
            <span class="status status-blue" title="Research results only. No broker connection or positions.">Research · no execution</span>
            <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
                <Authorized><form method="post" action="account/logout" data-enhance="false"><AntiforgeryToken /><button class="button button-ghost" type="submit">Sign out</button></form></Authorized>
            </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
        </div>
    </header>

    <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
    <Authorized>
    <nav class="sidebar" aria-label="Screens">
        <span class="nav-group">Market research</span>
        <NavLink href="" Match="NavLinkMatch.All">Market overview</NavLink>
        <NavLink href="catalysts">Catalyst calendar</NavLink>
        <NavLink href="event-record">Event record</NavLink>
        <NavLink href="tape">Signal analysis</NavLink>
        <NavLink href="decisions">Decision journal</NavLink>
        <span class="nav-group">Test &amp; understand</span>
        <NavLink href="history">Market history</NavLink>
        <NavLink href="outcomes">Outcomes record</NavLink>
        <NavLink href="replay">Historical replay</NavLink>
        <NavLink href="guide">How it works</NavLink>
        <span class="nav-group">Workspace</span>
        <NavLink href="sources">Data &amp; health</NavLink>
        <NavLink href="configuration">Model settings</NavLink>
        <div class="nav-ecosystem"><span class="nav-group">PrimeScore AI</span><a href="@BrandUrl">About the brand ↗</a><a href="@ProductUrl">About Markets ↗</a></div>
    </nav>
    </Authorized>
    </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>

    <main class="content" id="main">
        @Body
    </main>

    <footer class="footnote">
        PrimeScore Markets · A PrimeScore AI product. Recorded observations → volatility states → measured outcomes.
        <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
            <Authorized><a href="guide">Read the workflow</a> · </Authorized>
        </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
        No orders or positions.
    </footer>
</div>
@code {
    private bool LocalPreview => new Uri(Navigation.BaseUri) is { IsLoopback: true, Port: 5080 };
    private string BrandUrl => LocalPreview ? PreviewUrl(8090) : "https://primescore.ai/";
    private string ProductUrl => LocalPreview ? PreviewUrl(8091) : "https://markets.primescore.ai/";
    private string PreviewUrl(int port) => new UriBuilder(Navigation.BaseUri) { Port = port, Path = "/", Query = "", Fragment = "" }.Uri.ToString();
}
